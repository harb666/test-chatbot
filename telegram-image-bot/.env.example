# Get a token from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated numeric Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Optional: cooldown between image requests per user, in seconds (default 10)
COOLDOWN_SECONDS=10

# Optional: default generated image size in pixels (default 1024)
IMAGE_SIZE=1024
